{
  "name": "@payrollpro/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run --no-file-parallelism",
    "typecheck": "tsc -p .",
    "db:generate": "drizzle-kit generate",
    "fresh": "tsx src/db/fresh.ts",
    "export:sqlite": "tsx src/db/export-sqlite.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@node-rs/argon2": "^2.0.2",
    "@payrollpro/engines": "*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.38.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^12.0.1",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.30.1",
    "supertest": "^7.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
