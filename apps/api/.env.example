# Copy to .env. Required:
# DATABASE_URL=mysql://payroll:payroll@127.0.0.1:3306/payrollpro   # password URL-encoded (@ → %40)
# Optional (generated into apps/api/.data/dev-secrets.json when missing — keep that file):
# JWT_SECRET=           # openssl rand -base64 48
# FIELD_ENCRYPTION_KEY= # openssl rand -base64 32 — losing it makes PAN/bank data unreadable
# CORS_ORIGIN=https://payroll.yourcompany.com
# PORT=4000
