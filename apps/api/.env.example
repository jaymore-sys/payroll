# Copy to .env only if you need to override defaults. With no .env at all, `npm run dev` works:
#   - the database is embedded PostgreSQL (PGlite) stored in apps/api/.data/db
#   - dev secrets are generated once into apps/api/.data/dev-secrets.json
# For production, set ALL of these (NODE_ENV=production refuses to start without them):

# DATABASE_URL=postgresql://payroll:payroll@localhost:5432/payrollpro
# JWT_SECRET=           # openssl rand -base64 48
# FIELD_ENCRYPTION_KEY= # openssl rand -base64 32 — keep it in a secrets manager; losing it makes PAN/bank data unreadable
# CORS_ORIGIN=https://payroll.yourcompany.com
# PORT=4000
# NODE_ENV=production
