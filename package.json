{
  "name": "payrollpro",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "setup": "npm install",
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @payrollpro/api",
    "dev:web": "npm run dev -w @payrollpro/web",
    "test": "npm test -w @payrollpro/engines && npm test -w @payrollpro/api",
    "typecheck": "tsc -p packages/engines && tsc -p apps/api && tsc -p apps/web",
    "build": "npm run build -w @payrollpro/web",
    "db:migrate": "npm run db:migrate -w @payrollpro/api",
    "db:seed": "npm run db:seed -w @payrollpro/api",
    "fresh": "npm run fresh -w @payrollpro/api --",
    "start": "npm start -w @payrollpro/api",
    "export:sqlite": "npm run export:sqlite -w @payrollpro/api",
    "db:copy-to-postgres": "npm run db:copy-to-postgres -w @payrollpro/api",
    "import:razorpay": "npm run import:razorpay -w @payrollpro/api --"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
